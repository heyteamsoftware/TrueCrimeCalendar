<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Fotos de Wikipedia/Wikimedia y capa de mapa detallado (el resto funciona sin conexión). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Podcast con la pantalla apagada (servicio en primer plano de reproducción multimedia). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Avisos diarios de efemérides (y reprogramarlos tras reiniciar el móvil). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TrueCrimeCalendar">

        <!-- configChanges: al girar el móvil no se recarga la página ni se pierde lo abierto. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|uiMode|fontScale"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Podcast (Media3). Exportado, como pide Media3, para que la notificación multimedia,
             la pantalla de bloqueo, los auriculares Bluetooth o el reloj puedan controlarlo. -->
        <service
            android:name=".audio.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!-- Alarma diaria de los avisos. -->
        <receiver
            android:name=".notificaciones.AvisoDiarioReceiver"
            android:exported="false" />

        <!-- Reprograma los avisos. Son difusiones protegidas: solo puede enviarlas el sistema. -->
        <receiver
            android:name=".notificaciones.ReprogramarAvisosReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
